{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@syncboard/web", "dev"],
      "port": 3000
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@syncboard/web",
        "exec",
        "next",
        "start",
        "--port",
        "3200"
      ],
      "port": 3200
    }
  ]
}
