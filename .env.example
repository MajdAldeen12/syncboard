# Copy to apps/web/.env.local and fill in your own values.
# Never commit real values and never paste them into chat.
# Nothing here is read by the app yet; variables come into use from M3 and M5.

# --- apps/web -------------------------------------------------------------
# Supabase project (Settings > API). Use the new publishable key, not the legacy anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase shared pooler, transaction mode. Used by the app at runtime.
DATABASE_URL=
# Direct connection. Used only by drizzle-kit migrations.
DATABASE_URL_DIRECT=

# Ed25519 private key that signs sync tickets. Lives in the web app only.
SYNC_TICKET_PRIVATE_KEY=

# Host of the sync server, without protocol. Local dev: localhost:8787
NEXT_PUBLIC_SYNC_HOST=localhost:8787

# Id of the public demo board row.
DEMO_BOARD_ID=

# --- apps/sync (copy these to apps/sync/.dev.vars) ------------------------
# Matching Ed25519 public key. The sync server can verify tickets but not mint them.
SYNC_TICKET_PUBLIC_KEY=
# Comma-separated origins allowed to open a WebSocket.
ALLOWED_ORIGINS=http://localhost:3000
